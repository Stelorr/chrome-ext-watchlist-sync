{
  "manifest_version": 3,
  "name": "Watchlist Sync",
  "version": "0.1.0",
  "description": "Sync your trading watchlist across platforms with one click.",
  "action": {
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"]
}
